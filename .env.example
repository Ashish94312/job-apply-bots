# Copy to .env and fill in. Instahyre, Wellfound and LinkedIn log in with a password
# (LinkedIn's is optional: without it you log in once by hand, as on Cutshort and Hirist).
INSTAHYRE_EMAIL=you@example.com
INSTAHYRE_PASSWORD='your-password'
WELLFOUND_EMAIL=you@example.com
WELLFOUND_PASSWORD='your-password'
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD='your-password'
