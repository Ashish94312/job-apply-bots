# Copy to .env and fill in. Instahyre, Wellfound and LinkedIn log in with a password
# (LinkedIn's is optional: without it you log in once by hand, as on Cutshort and Hirist).
INSTAHYRE_EMAIL=you@example.com
INSTAHYRE_PASSWORD='your-password'
WELLFOUND_EMAIL=you@example.com
WELLFOUND_PASSWORD='your-password'
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD='your-password'

# Publishing updates to the Chrome Web Store with tools/publish_extension.py (see extension/README.md > Publishing).
# CWS_PUBLISHER_ID=        # Developer Dashboard > Publisher > Settings
# CWS_EXTENSION_ID=        # the published extension's 32-letter id
# CWS_CLIENT_ID=           # OAuth client ("Desktop app") from a Google Cloud project with the Chrome Web Store API on
# CWS_CLIENT_SECRET=
# CWS_REFRESH_TOKEN=       # written by: .venv/bin/python tools/publish_extension.py --setup
