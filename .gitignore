.venv/
__pycache__/
# Secrets (passwords) live here.
.env
# Each bot's browser profile (your logged-in sessions), history and screenshots. Never commit.
data/
# Your personal settings (salary, notice period, ...). config.example.yaml is the template.
config.yaml
# macOS Finder files
.DS_Store
# Export for the Chrome extension: has your answers (phone, salary...) in it.
extension-import.json
# The extension's end-to-end test downloads React here.
extension/tests/.cache/
# Chrome Web Store packages: tools/package_extension.py
dist/
