{
  "manifest_version": 3,
  "name": "Sendoff",
  "version": "0.1.0",
  "description": "Sends your job applications off for you: applies on Hirist, Instahyre and Wellfound with your filters and answers to screening questions. Runs in your own Chrome.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.hirist.tech/*",
    "https://hirist.tech/*",
    "https://www.instahyre.com/*",
    "https://instahyre.com/*",
    "https://wellfound.com/*",
    "https://www.wellfound.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sendoff: open the dashboard",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
