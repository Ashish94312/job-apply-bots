{
  "manifest_version": 3,
  "name": "Sendoff",
  "short_name": "Sendoff",
  "version": "1.1.0",
  "description": "Applies to jobs for you on Hirist, Instahyre, Wellfound, Cutshort, LinkedIn and Naukri, with your filters and answers.",
  "homepage_url": "https://github.com/Ashish94312/job-apply-bots/tree/chrome-extension/extension",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.hirist.tech/*",
    "https://hirist.tech/*",
    "https://www.instahyre.com/*",
    "https://instahyre.com/*",
    "https://wellfound.com/*",
    "https://www.wellfound.com/*",
    "https://cutshort.io/*",
    "https://www.cutshort.io/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.naukri.com/*",
    "https://naukri.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sendoff: open the dashboard",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
